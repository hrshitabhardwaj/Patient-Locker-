# Copy to .env with `make env` (fills in generated secrets). Never commit .env.
# Comments must be on their own line.

# ---- Application ----
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated list of portal origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ---- Database (local Homebrew PostgreSQL 16) ----
# `make env` replaces CHANGE_ME with a generated password; `make db-create` creates the role and databases.
DATABASE_URL=postgresql+psycopg://patient_locker:CHANGE_ME@localhost:5432/patient_locker
TEST_DATABASE_URL=postgresql+psycopg://patient_locker:CHANGE_ME@localhost:5432/patient_locker_test

# ---- Security (generated by `make env`) ----
# URL-safe base64 encoding of 32 random bytes (AES-256 key for files at rest)
FILE_ENCRYPTION_KEY=
# Session lifetime and login lockout (defaults shown)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# ---- File storage and uploads ----
# Relative paths are resolved from the project root
STORAGE_DIR=storage
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
MAX_IMAGE_PIXELS=40000000

# ---- Patients ----
# Country assumed for phone numbers entered without a country code
DEFAULT_PHONE_REGION=IN

# ---- Text extraction ----
# Tesseract languages, e.g. eng or eng+hin (extra languages: brew install tesseract-lang)
OCR_LANGUAGES=eng
OCR_DPI=300

# ---- LLM ----
# ollama (local, development) | anthropic (hosted, adapter added once a company key exists) | none
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct
LLM_TIMEOUT_SECONDS=300
LLM_PROFILE_MAX_PAGES=3
LLM_IMAGE_MAX_PX=1024
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Ask the model to double-check COVERED decisions (a "no" sends the point to staff review).
# Off by default: the local model raised false doubts on the dev letters.
MATCH_MODEL_CHECK=false

# ---- Patient messages (values used in the message templates) ----
# Messages are blocked and sent to staff until these are set.
COMPANY_NAME=
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Days given to the patient when the insurer's letter sets no deadline (0 = send to staff)
PATIENT_RESPONSE_DAYS=7

# ---- Background worker ----
WORKER_POLL_SECONDS=1.0
JOB_LEASE_MINUTES=20

# ---- WhatsApp (used from Phase 9; live credentials added in Phase 12) ----
# fake | twilio | meta
WHATSAPP_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v22.0

# ---- Email (used from Phase 9; live credentials added in Phase 12) ----
# fake | resend
EMAIL_PROVIDER=fake
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
